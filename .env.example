# All optional. The app runs fully without any of these (demo mode, data saved in the browser).

# Real sign-in (Supabase Auth). Create a free project at supabase.com, run supabase/schema.sql,
# then paste the project URL and anon (public) key here or in Vercel > Settings > Environment Variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Higher GitHub rate limits for "Import from GitHub" (a fine-grained token with public read access is enough).
GITHUB_TOKEN=

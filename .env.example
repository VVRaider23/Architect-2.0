# Everything here is optional. With nothing set, the app runs in demo mode (data saved in the browser).

# Real accounts and a database. On Vercel: Storage → Create Database → Neon, which sets DATABASE_URL for you.
# Tables are created automatically on first use.
DATABASE_URL=

# Signs session cookies and encrypts stored GitHub tokens. If empty, a key is derived from DATABASE_URL.
AUTH_SECRET=

# Real GitHub: sign in with GitHub, list your repos, push code and open pull requests.
# Create an OAuth App at github.com/settings/developers with the callback URL
# https://<your-site>/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Real AI answers in the chat, the agent playground and the AI Consultant. Set one of these.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override, e.g. claude-haiku-4-5-20251001 or gpt-4.1-mini
AI_MODEL=

# Optional: higher GitHub rate limits for reading public repos on the Import screen.
GITHUB_TOKEN=
